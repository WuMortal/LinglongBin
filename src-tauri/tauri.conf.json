{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinglongBin",
  "version": "0.1.0",
  "identifier": "com.linglong.bin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LinglongBin",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/images/**", "$RESOURCE/files/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:data.db", "sqlite:sys.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEMDRDQUQwMDY1QzRENTAKUldSUVRWd0cwTW9FWGR3U0VFLy84MUE4RytBK1JvOXAyamhwMFdZbnEvNlU2MVpndG9QZ3RsTUkK",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/WuMortal/LinglongBin/releases/download/v0.0.0/latest.json"
      ]
    }
  }
}
